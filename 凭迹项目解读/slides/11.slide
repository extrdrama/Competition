<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '0 70px', fontFamily: "'思源黑体', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', gap: 16, paddingTop: 24 }}>
    <Box style={{ width: 5, height: 40, background: '#3B82F6', borderRadius: 2 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>一图看懂：正常 → 泄露 → 检测 → 解决</Text>
  </Box>
  <Box style={{ height: 540, alignItems: 'center' }}>
    <svg viewBox="0 0 680 568" width={640} role="img"><title>凭据泄露与检测解决全流程图</title><desc>四条泳道：正常、泄露、检测（凭迹，我们的项目）、解决（闭环回到安全）。</desc><defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/></marker></defs><text x="40" y="34" fontSize="15" fill="#0F172A" fontWeight="500" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">凭据泄露全流程：正常 → 泄露 → 检测 → 解决</text><rect x="40" y="56" width="600" height="110" rx="12" fill="#EAF3DE"/><rect x="56" y="66" width="76" height="22" rx="11" fill="#FFFFFF" stroke="#97C459" strokeWidth="0.75"/><text x="94" y="77" fontSize="12" fill="#27500A" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">① 正常</text><rect x="140" y="72" width="210" height="56" rx="8" fill="#FFFFFF" stroke="#3B6D11" strokeWidth="0.75"/><text x="245.0" y="94" fontSize="14" fill="#27500A" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">凭据安全托管</text><text x="245.0" y="115" fontSize="11.5" fill="#3B6D11" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">（Vault / CI 环境变量）</text><path d="M354 100 L392 100" fill="none" stroke="#3B6D11" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="400" y="72" width="200" height="56" rx="8" fill="#FFFFFF" stroke="#3B6D11" strokeWidth="0.75"/><text x="500.0" y="94" fontSize="14" fill="#27500A" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">程序正常调用</text><text x="500.0" y="115" fontSize="11.5" fill="#3B6D11" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">云服务，一切正常</text><rect x="40" y="176" width="600" height="110" rx="12" fill="#FAECE7"/><rect x="56" y="186" width="76" height="22" rx="11" fill="#FFFFFF" stroke="#F0997B" strokeWidth="0.75"/><text x="94" y="197" fontSize="12" fill="#712B13" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">② 泄露</text><path d="M245 128 L245 158 L230 158 L230 186" fill="none" stroke="#993C1D" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" strokeDasharray="4 3" markerEnd="url(#arrow)"/><text x="257" y="156" fontSize="12" fill="#993C1D" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">一旦图省事 / 失误</text><rect x="140" y="192" width="170" height="56" rx="8" fill="#FFFFFF" stroke="#993C1D" strokeWidth="0.75"/><text x="225.0" y="214" fontSize="14" fill="#712B13" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">图省事的失误</text><text x="225.0" y="235" fontSize="11.5" fill="#993C1D" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">硬编码上传 / 误贴配置</text><path d="M314 220 L334 220" fill="none" stroke="#993C1D" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="340" y="192" width="160" height="56" rx="8" fill="#F59E0B" stroke="#B45309" strokeWidth="0.75"/><text x="420" y="214" fontSize="14" fill="#FFFFFF" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">公开渠道</text><text x="420" y="235" fontSize="11.5" fill="#FFF7E6" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">Gist·Paste·镜像·App 包</text><path d="M504 220 L524 220" fill="none" stroke="#A32D2D" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" strokeDasharray="4 3" markerEnd="url(#arrow)"/><rect x="530" y="192" width="110" height="56" rx="8" fill="#FFFFFF" stroke="#A32D2D" strokeWidth="0.75"/><text x="585.0" y="214" fontSize="14" fill="#791F1F" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">攻击者扫到</text><text x="585.0" y="235" fontSize="11.5" fill="#A32D2D" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">挖矿·拖库·删库</text><rect x="40" y="296" width="600" height="110" rx="12" fill="#E6F1FB" stroke="#185FA5" strokeWidth="1.5" strokeDasharray="6 4"/><rect x="56" y="306" width="76" height="22" rx="11" fill="#FFFFFF" stroke="#85B7EB" strokeWidth="0.75"/><text x="94" y="317" fontSize="12" fill="#0C447C" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">③ 检测</text><path d="M420 248 L420 272 L245 272 L245 306" fill="none" stroke="#185FA5" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="140" y="312" width="210" height="56" rx="8" fill="#FFFFFF" stroke="#185FA5" strokeWidth="0.75"/><text x="245.0" y="334" fontSize="14" fill="#0C447C" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">凭迹 CredWatch</text><text x="245.0" y="355" fontSize="11.5" fill="#185FA5" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">7×24 持续监测公开渠道</text><path d="M354 340 L392 340" fill="none" stroke="#185FA5" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="400" y="312" width="200" height="56" rx="8" fill="#FFFFFF" stroke="#185FA5" strokeWidth="0.75"/><text x="500.0" y="334" fontSize="14" fill="#0C447C" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">识别与验证</text><text x="500.0" y="355" fontSize="11.5" fill="#185FA5" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">195 规则·评分·去重·验活</text><rect x="436" y="286" width="196" height="20" rx="10" fill="#185FA5"/><text x="534" y="296" fontSize="11" fill="#FFFFFF" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">我们的项目 · 凭迹 CredWatch</text><text x="450" y="262" fontSize="12" fill="#475569" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">与攻击者赛跑：它几分钟内也会扫到，</text><text x="450" y="278" fontSize="12" fill="#854F0B" fontWeight="500" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">凭迹最快 2.4 分钟抢先告警。</text><rect x="40" y="416" width="600" height="110" rx="12" fill="#E1F5EE"/><rect x="56" y="426" width="76" height="22" rx="11" fill="#FFFFFF" stroke="#5DCAA5" strokeWidth="0.75"/><text x="94" y="437" fontSize="12" fill="#085041" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">④ 解决</text><path d="M500 368 L500 386 L230 386 L230 424" fill="none" stroke="#0F6E56" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="140" y="432" width="180" height="56" rx="8" fill="#FFFFFF" stroke="#0F6E56" strokeWidth="0.75"/><text x="230.0" y="454" fontSize="14" fill="#085041" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">告警通知主人</text><text x="230.0" y="475" fontSize="11.5" fill="#0F6E56" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">只含掩码 · 明文不落盘</text><rect x="140" y="424" width="76" height="16" rx="8" fill="#185FA5"/><text x="178" y="432" fontSize="11" fill="#FFFFFF" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">凭迹产出</text><path d="M324 460 L344 460" fill="none" stroke="#0F6E56" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="350" y="432" width="110" height="56" rx="8" fill="#FFFFFF" stroke="#0F6E56" strokeWidth="0.75"/><text x="405.0" y="454" fontSize="14" fill="#085041" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">吊销 / 换锁</text><text x="405.0" y="475" fontSize="11.5" fill="#0F6E56" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">密钥立即失效</text><path d="M464 460 L484 460" fill="none" stroke="#0F6E56" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"  markerEnd="url(#arrow)"/><rect x="490" y="432" width="150" height="56" rx="8" fill="#FFFFFF" stroke="#0F6E56" strokeWidth="0.75"/><text x="565.0" y="454" fontSize="14" fill="#085041" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">根因修复 + 复核</text><text x="565.0" y="475" fontSize="11.5" fill="#0F6E56" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">密钥移出代码并轮换</text><path d="M626 432 L626 100 L608 100" fill="none" stroke="#0F6E56" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" strokeDasharray="5 4" markerEnd="url(#arrow)"/><text x="390" y="512" fontSize="12" fill="#0F6E56" fontWeight="500" textAnchor="middle" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">复核闭环 · 回到 ① 安全状态</text><circle cx="46" cy="548" r="5" fill="#639922"/><text x="58" y="548" fontSize="12" fill="#475569" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">① 安全状态</text><circle cx="150" cy="548" r="5" fill="#E24B4A"/><text x="162" y="548" fontSize="12" fill="#475569" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">② 泄露风险</text><circle cx="254" cy="548" r="5" fill="#378ADD"/><text x="266" y="548" fontSize="12" fill="#475569" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">③ 检测（我们的项目）</text><circle cx="413" cy="548" r="5" fill="#1D9E75"/><text x="425" y="548" fontSize="12" fill="#475569" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">④ 处置闭环</text><text x="640" y="548" fontSize="12" fill="#854F0B" fontWeight="500" textAnchor="end" fontFamily="'思源黑体', 'Microsoft YaHei', sans-serif" dominantBaseline="central">实测最快 2.4 分钟抢先告警</text></svg>
  </Box>
