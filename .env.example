# ============================================================
# 凭迹 CredWatch 环境变量样例
# 复制为 .env 后填写。所有字段均为可选，缺失时对应渠道自动跳过。
# ============================================================

# ---------- 指纹盐值（务必修改，用于对凭据做 HMAC 脱敏） ----------
# 平台只保存 HMAC 指纹 + 掩码，绝不落盘明文。此盐值一旦更换，
# 历史指纹将无法与新增指纹比对，请妥善保管。
CREDWATCH_HMAC_SALT=change-me-please-use-a-random-32-byte-string

# ---------- 存储 ----------
CREDWATCH_DB=./data/credwatch.db

# ---------- 代码托管平台 ----------
# GitHub 细粒度 PAT，仅需 public_repo / read 权限；建议准备多个轮换
GITHUB_TOKENS=
GITEE_TOKEN=
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# ---------- 社媒 / 知识共享 ----------
WEIBO_ACCESS_TOKEN=

# ---------- 容器镜像仓库（公开仓库只读拉取，无需凭据） ----------
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# ---------- 活性验证开关（默认关闭；开启后仅调用只读身份接口） ----------
# 强烈建议：仅在获得授权或对自有资产验证时开启。
CREDWATCH_ENABLE_VALIDATION=false
# 单个凭据验证超时（秒）
CREDWATCH_VALIDATE_TIMEOUT=8
# 每分钟最多验证多少个凭据，防止对第三方造成压力
CREDWATCH_VALIDATE_RATE_LIMIT=20

# ---------- 出网代理（可选） ----------
HTTP_PROXY=
HTTPS_PROXY=
